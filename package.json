{
    "name": "Mark",
    "version": "3.1.0",
    "description": "Editor Markdown",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder"
    },
    "keywords": [],
    "author": {
        "name": "Gaetano",
        "email": "gaetanocarbone2004@gmail.com"
    },
    "license": "ISC",
    "devDependencies": {
        "electron": "^44.9.1",
        "electron-builder": "^26.15.3"
    },
    "dependencies": {
        "@electron/remote": "^2.1.2",
        "build": "^0.1.4",
        "electron-updater": "^6.8.9",
        "markitdown-js": "^0.0.14",
        "y-webrtc": "^10.3.0",
        "yjs": "^13.6.33"
    },
    "build": {
        "appId": "com.Giovanni.Mark",
        "productName": "Mark",
        "executableName": "mark",
        "fileAssociations": [
            {
                "ext": "md",
                "name": "Markdown File",
                "description": "File Markdown",
                "role": "Editor",
                "icon": "build/mark.png"
            }
        ],
        "directories": {
            "output": "dist"
        },
        "win": {
            "icon": "build/mark.ico",
            "target": [
                "nsis"
            ],
            "signAndEditExecutable": false
        },
        "nsis": {
            "oneClick": true,
            "installerIcon": "build/mark.ico",
            "uninstallerIcon": "build/mark.ico",
            "installerHeaderIcon": "build/mark.ico"
        },
        "mac": {
            "icon": "build/mark.icns",
            "target": [
                "dmg"
            ]
        },
        "linux": {
            "icon": "build/mark.png",
            "target": ["dir"]
        },
        "publish": [
            {
                "provider": "github",
                "owner": "gwetano",
                "repo": "mark"
            }
        ]
    }
}